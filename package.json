{
  "name": "q-en-speaking",
  "productName": "Speaking Studio",
  "version": "1.1.0",
  "private": true,
  "description": "英文口說、對話與語境學習的 Windows 桌面 App",
  "author": "Speaking Studio",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "setup:speech": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-speech.ps1",
    "test:desktop": "npm run build && node scripts/smoke.cjs",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "pack:dir": "npm run build && electron-builder --dir",
    "format": "prettier --write src electron shared tests scripts/*.cjs *.json vite.config.ts"
  },
  "dependencies": {
    "jose": "^6.2.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "beforePack": "./scripts/verify-speech.cjs",
    "appId": "com.qen.speakingstudio",
    "productName": "Speaking Studio",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
